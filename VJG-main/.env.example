# --- Database ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
PORT=5050

# --- SMTP (Zoho example) ---
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
# Optional: override auto-detection. true for 465, false for 587.
# SMTP_SECURE=true
SMTP_EMAIL=info@example.com
SMTP_PASSWORD=your-smtp-or-app-password
RECEIVER_EMAIL=info@example.com

# --- Internship Certificate Management System ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Change@Me123
SEED_ADMIN_NAME=Site Admin
PUBLIC_BASE_URL=http://localhost:5050
